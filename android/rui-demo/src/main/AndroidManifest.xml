<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Druid asks for it at run time (the demo's "Ask for the camera"). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <application android:label="Druid on RUI">
        <!-- The launcher opens RUI's RuiActivity (from the rui library) directly. -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity="dev.rui.android.RuiActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
