<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Normal permissions (granted at install) the services use. Dangerous
         ones (location, camera, ...) are the app's to declare: Druid cannot
         know which the app needs. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Alarms and persisted jobs are set again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Foreground (Foreground.start). Android 14+ also wants the permission of
         the kind of work, e.g. FOREGROUND_SERVICE_LOCATION: the app declares it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <application>
        <!-- Asks for runtime permissions on behalf of any Activity (a
             NativeActivity cannot receive the result) and finishes at once. -->
        <activity
            android:name="dev.druid.DruidPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- A notification's buttons, inline reply and dismissal (Notifications.showFull). -->
        <receiver android:name="dev.druid.DruidNotificationReceiver" android:exported="false" />
        <!-- Alarms firing, and re-armed after a reboot (Alarms). -->
        <receiver android:name="dev.druid.DruidAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Background jobs (Jobs). -->
        <service
            android:name="dev.druid.DruidJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Keeps the process running while the app works in the background
             (Foreground). On Android 14+ the app's manifest adds the kind of work:
             <service android:name="dev.druid.DruidForegroundService"
                 android:foregroundServiceType="location" tools:node="merge" /> -->
        <service android:name="dev.druid.DruidForegroundService" android:exported="false" />
    </application>
</manifest>
