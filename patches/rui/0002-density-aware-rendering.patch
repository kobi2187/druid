diff --git a/packages/rui_core/src/pixel_density.nim b/packages/rui_core/src/pixel_density.nim
new file mode 100644
index 0000000..098f174
--- /dev/null
+++ b/packages/rui_core/src/pixel_density.nim
@@ -0,0 +1,56 @@
+## Physical pixels per logical pixel: what makes RUI sharp on a phone.
+##
+## Layout, widget bounds, events and font sizes are in logical pixels (Android's
+## dp). The window, the widget textures and the glyph rasters are in physical
+## pixels. With `pixelScale` 2.625 (a 420 dpi phone), a 360-wide layout fills a
+## 945-pixel screen with every edge and glyph drawn at full resolution -- not a
+## 360-pixel picture stretched to fit, which is what makes text soft.
+##
+## The App sets it when it opens the window: on Android from the display's
+## density (dpi / 160), on the desktop from `RUI_SCALE` (default 1), so a
+## desktop window can show a phone's layout at the phone's sharpness.
+
+import std/math
+import raylib, rlgl
+
+var pixelScale*: float32 = 1
+  ## Physical pixels per logical pixel.
+
+proc toPhysical*(v: float32): float32 {.inline.} = v * pixelScale
+proc toLogical*(v: float32): float32 {.inline.} = v / pixelScale
+
+proc snapLogical*(v: float32): float32 {.inline.} =
+  ## `v` moved onto the nearest physical pixel, still in logical units.
+  round(v * pixelScale) / pixelScale
+
+proc physicalExtent*(logical: float32): int32 {.inline.} =
+  ## How many physical pixels a logical length covers (at least one).
+  max(1'i32, int32(round(logical * pixelScale)))
+
+proc logicalScreenWidth*(): float32 = getScreenWidth().float32 / pixelScale
+proc logicalScreenHeight*(): float32 = getScreenHeight().float32 / pixelScale
+  ## The window's size in logical pixels: what the layout fills.
+
+proc logicalMousePosition*(): Vector2 =
+  let p = getMousePosition()
+  Vector2(x: p.x / pixelScale, y: p.y / pixelScale)
+
+proc logicalTouchPosition*(index: int32): Vector2 =
+  let p = getTouchPosition(index)
+  Vector2(x: p.x / pixelScale, y: p.y / pixelScale)
+
+proc logicalMouseDelta*(): Vector2 =
+  let p = getMouseDelta()
+  Vector2(x: p.x / pixelScale, y: p.y / pixelScale)
+
+template scaledDrawing*(body: untyped) =
+  ## Draw `body` in logical coordinates onto a physical target (the screen or a
+  ## widget texture): everything is scaled by `pixelScale` on the way.
+  if pixelScale == 1:
+    body
+  else:
+    rlgl.pushMatrix()
+    rlgl.scalef(pixelScale, pixelScale, 1)
+    body
+    rlgl.drawRenderBatchActive()
+    rlgl.popMatrix()
