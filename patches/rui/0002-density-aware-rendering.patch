diff --git a/tests/gl/pixel_density.nim b/tests/gl/pixel_density.nim
new file mode 100644
index 0000000..3731241
--- /dev/null
+++ b/tests/gl/pixel_density.nim
@@ -0,0 +1,75 @@
+## Physical pixels per logical pixel (rui_core/pixel_density.nim) at 2x: the
+## window is twice the layout, everything lands on the physical pixels its
+## logical position says, widget textures and glyphs are drawn at the screen's
+## resolution (not a 1x picture stretched), and positions come back logical.
+
+import std/os
+import rui
+from raylib import loadImageFromScreen, getImageColor, getScreenWidth, getScreenHeight
+
+putEnv("RUI_SCALE", "2")
+let app = newApp("pixel density", 200, 120)
+let square = newRectangle(color = Color(r: 0, g: 0, b: 0, a: 255))
+let placed = newPositioned(left = 50, top = 40, width = 20, height = 20)
+placed.addChild(square)
+let label = newLabel(text = "Mm", fontSize = 14.0)
+let labelAt = newPositioned(left = 100, top = 10)
+labelAt.addChild(label)
+let root = newStack(fit = StackFit.expand)
+root.addChild(placed)
+root.addChild(labelAt)
+app.setRootWidget(root)
+
+var problems: seq[string]
+var frames = 0
+proc dark(c: Color): bool = c.r.int + c.g.int + c.b.int < 300
+  ## Mostly ink: an edge pixel is anti-aliased (85 % here), the canvas is near white.
+
+app.onFrame = proc() =
+  inc frames
+  if frames != 4: return
+  if pixelScale != 2: problems.add "pixelScale is " & $pixelScale
+  if getScreenWidth() != 400 or getScreenHeight() != 240:
+    problems.add "window is " & $getScreenWidth() & "x" & $getScreenHeight() & ", not 400x240"
+  if root.bounds.width != 200 or root.bounds.height != 120:
+    problems.add "layout is not logical: " & $root.bounds
+  let shot = loadImageFromScreen()
+  # The 20x20 square at (50, 40) covers physical (100..139, 80..119): each
+  # edge's last pixel is in, the next one out (probed mid-edge: the theme may
+  # round the corners).
+  for (x, y, want) in [(100, 100, true), (139, 100, true), (120, 80, true), (120, 119, true),
+                       (99, 100, false), (140, 100, false), (120, 79, false), (120, 120, false)]:
+    if dark(getImageColor(shot, x.int32, y.int32)) != want:
+      problems.add "pixel (" & $x & ", " & $y & ") should " & (if want: "" else: "not ") & "be the square"
+  # Textures at the screen's resolution: twice the bounds.
+  # (move-only textures: read through the widget, never copied)
+  if square.cachedTexture.isSome and (square.cachedTexture.get.texture.width != 40 or
+                                      square.cachedTexture.get.texture.height != 40):
+    problems.add "square's texture is " & $square.cachedTexture.get.texture.width & "x" &
+                 $square.cachedTexture.get.texture.height & ", not 40x40"
+  if label.cachedTexture.isNone or
+     label.cachedTexture.get.texture.width < int32(label.bounds.width * 2) - 1:
+    problems.add "label's texture is not at 2x its bounds " & $label.bounds
+  # Glyphs rasterised at 2x: a vertical stem of the "M" is two physical pixels
+  # or more of solid ink, not one pixel stretched (which would be soft-edged).
+  proc lum(c: Color): int = c.r.int + c.g.int + c.b.int
+  let paper = lum(getImageColor(shot, 300, 200))
+  var ink, inkRows = 0
+  for y in 20 .. 60:
+    var rowInk = 0
+    for x in 200 .. 270:
+      if lum(getImageColor(shot, x.int32, y.int32)) < paper div 2: inc rowInk
+    ink += rowInk
+    if rowInk > 0: inc inkRows
+  # Text 14 pt high is about 19 logical pixels: 38 physical rows at 2x. A 1x
+  # raster stretched would give at most half the rows of full-strength ink.
+  if inkRows < 14:
+    problems.add "the label's ink covers " & $inkRows & " physical rows; a 2x raster covers 14 or more"
+  # Positions are logical: the square is what is at logical (60, 50).
+  if app.hitTestSystem.getWidgetAt(60, 50) notin [square, placed]:
+    problems.add "hit test at logical (60, 50) misses the square"
+
+app.run(maxFrames = 6)
+for p in problems: echo p
+if problems.len > 0: quit 1
+echo "pixel density ok"
diff --git a/tests/test_pixel_density.nim b/tests/test_pixel_density.nim
new file mode 100644
index 0000000..f41b6ce
--- /dev/null
+++ b/tests/test_pixel_density.nim
@@ -0,0 +1,27 @@
+## pixel_density.nim's arithmetic and the text cache's font scaling, without a window.
+
+import std/[unittest, math]
+import rui_core
+import rui_drawing
+
+suite "pixel density":
+  teardown: pixelScale = 1
+
+  test "1x changes nothing":
+    pixelScale = 1
+    check snapLogical(10.4) == 10
+    check physicalExtent(10.4) == 10
+    check toPhysical(3) == 3 and toLogical(3) == 3
+
+  test "fractional scales land on physical pixels":
+    pixelScale = 2.625                     # a 420 dpi phone
+    check physicalExtent(360) == 945
+    check abs(snapLogical(10.1) * 2.625 - round(10.1 * 2.625)) < 1e-4
+    check physicalExtent(0.1) == 1         # never empty
+    check toPhysical(16) == 42 and toLogical(42) == 16
+
+  test "fonts scale by their size":
+    check scaledFont("Roboto Bold 14", 2) == "Roboto Bold 28.000"
+    check scaledFont("Sans 10.5", 3) == "Sans 31.500"
+    check scaledFont("Roboto", 2) == "Roboto 20.000"
+    check scaledFont("Roboto 14", 1) == "Roboto 14"
